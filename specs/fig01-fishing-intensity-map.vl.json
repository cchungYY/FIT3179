{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 700,
  "height": 560,
  "title": {
    "text": "Where Commonwealth fishing happens, by year",
    "subtitle": "Each patch is an area of ocean where fishing was mapped. Drag the slider to change the year.",
    "anchor": "start",
    "offset": 8
  },
  "projection": {
    "type": "mercator",
    "scale": 730.9,
    "center": [
      137.0,
      -28.695
    ],
    "translate": [
      350.0,
      280.0
    ]
  },
  "params": [
    {
      "name": "year_sel",
      "value": 2024,
      "bind": {
        "input": "range",
        "min": 2010,
        "max": 2024,
        "step": 1,
        "name": "Year  "
      }
    }
  ],
  "layer": [
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/vega-datasets@2/data/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "transform": [
        {
          "filter": "datum.id == 36"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#f1e7d0",
        "stroke": null
      }
    },
    {
      "data": {
        "url": "data/fishing_intensity.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.year == year_sel"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#ffffff",
        "strokeWidth": 0.3
      },
      "encoding": {
        "color": {
          "field": "properties.intensity",
          "type": "ordinal",
          "scale": {
            "domain": [
              "Low",
              "Medium",
              "High"
            ],
            "range": [
              "#cfe6ee",
              "#4fa3b8",
              "#0b4f6c"
            ]
          },
          "legend": {
            "title": [
              "Fishing intensity",
              "catch weight, kg per km²"
            ],
            "orient": "bottom-left",
            "offset": 8,
            "labelExpr": "{\"2010\":{\"Low\":\"Low: under 60\",\"Medium\":\"Medium: 60 to 300\",\"High\":\"High: 300 to 900\"},\"2011\":{\"Low\":\"Low: under 60\",\"Medium\":\"Medium: 60 to 300\",\"High\":\"High: 300 to 854\"},\"2012\":{\"Medium\":\"Medium: 60 to 300\",\"Low\":\"Low: under 60\",\"High\":\"High: 300 to 800\"},\"2013\":{\"Medium\":\"Medium: 60 to 300\",\"Low\":\"Low: under 60\",\"High\":\"High: 300 to 900\"},\"2014\":{\"Low\":\"Low: under 50\",\"Medium\":\"Medium: 50 to 250\",\"High\":\"High: 250 to 815\"},\"2015\":{\"Medium\":\"Medium: 50 to 250\",\"Low\":\"Low: under 50\",\"High\":\"High: 250 to 900\"},\"2016\":{\"Low\":\"Low: under 200\",\"Medium\":\"Medium: 200 to 800\",\"High\":\"High: 800 to 1,600\"},\"2017\":{\"Low\":\"Low: under 100\",\"Medium\":\"Medium: 100 to 300\",\"High\":\"High: 300 to 900\"},\"2018\":{\"Low\":\"Low: under 150\",\"Medium\":\"Medium: 150 to 750\",\"High\":\"High: 750 to 1,800\"},\"2019\":{\"Low\":\"Low: under 500\",\"High\":\"High: 1,500 to 3,500\",\"Medium\":\"Medium: 500 to 1,500\"},\"2020\":{\"Low\":\"Low: under 250\",\"Medium\":\"Medium: 250 to 1,000\",\"High\":\"High: 1,000 to 2,750\"},\"2021\":{\"Low\":\"Low: under 250\",\"Medium\":\"Medium: 250 to 1,000\",\"High\":\"High: 1,000 to 2,500\"},\"2022\":{\"Low\":\"Low: under 300\",\"Medium\":\"Medium: 300 to 1,200\",\"High\":\"High: 1,200 to 3,200\"},\"2023\":{\"Low\":\"Low: under 300\",\"Medium\":\"Medium: 300 to 1,200\",\"High\":\"High: 1,200 to 3,100\"},\"2024\":{\"Low\":\"Low: under 300\",\"High\":\"High: 1,200 to 3,300\",\"Medium\":\"Medium: 300 to 1,200\"}}[toString(year_sel)][datum.label]"
          }
        },
        "tooltip": [
          {
            "field": "properties.year",
            "title": "Year",
            "type": "quantitative",
            "format": "d"
          },
          {
            "field": "properties.intensity",
            "title": "Fishing intensity",
            "type": "ordinal"
          },
          {
            "field": "properties.range",
            "title": "Catch per km² (kg) in this class",
            "type": "nominal"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/state_borders.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#8c8068",
        "strokeWidth": 0.8,
        "strokeDash": [
          4,
          3
        ],
        "opacity": 0.9
      }
    },
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/vega-datasets@2/data/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "transform": [
        {
          "filter": "datum.id == 36"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#7d725c",
        "strokeWidth": 0.9
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 138.5,
            "lat": -11.0,
            "t": "Gulf of Carpentaria"
          },
          {
            "lon": 130,
            "lat": -36.2,
            "t": "Great Australian Bight"
          },
          {
            "lon": 146.5,
            "lat": -40.9,
            "t": "Bass Strait"
          },
          {
            "lon": 156,
            "lat": -19,
            "t": "Coral Sea"
          },
          {
            "lon": 156,
            "lat": -35,
            "t": "Tasman Sea"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontStyle": "italic",
        "fontSize": 11,
        "color": "#5a7280"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "t",
          "type": "nominal"
        }
      }
    }
  ]
}