{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 600,
  "height": 380,
  "title": {
    "text": "Then and now: 2008 compared with 2024",
    "subtitle": [
      "Share of assessed Commonwealth stocks in each status. Stocks that were not assessed that year",
      "are left out."
    ],
    "anchor": "start",
    "offset": 8
  },
  "data": {
    "url": "data/stock_status.csv"
  },
  "transform": [
    {
      "filter": "(datum.year == 2008 || datum.year == 2024) && datum.status != 'Not assessed'"
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "stocks",
          "as": "total"
        }
      ],
      "groupby": [
        "year"
      ]
    },
    {
      "calculate": "datum.stocks / datum.total",
      "as": "share"
    },
    {
      "calculate": "datum.status + '  ' + format(datum.share, '.0%')",
      "as": "label"
    },
    {
      "window": [
        {
          "op": "rank",
          "as": "label_rank"
        }
      ],
      "sort": [
        {
          "field": "share",
          "order": "descending"
        }
      ],
      "groupby": [
        "year"
      ]
    }
  ],
  "encoding": {
    "x": {
      "field": "year",
      "type": "quantitative",
      "scale": {
        "domain": [
          1999,
          2033
        ]
      },
      "axis": {
        "values": [
          2008,
          2024
        ],
        "format": "d",
        "title": null,
        "grid": false,
        "labelFontSize": 13
      }
    },
    "y": {
      "field": "share",
      "type": "quantitative",
      "axis": null
    },
    "color": {
      "field": "status",
      "type": "nominal",
      "scale": {
        "domain": [
          "Healthy",
          "Uncertain",
          "Overfishing",
          "Overfished"
        ],
        "range": [
          "#1f7a74",
          "#a3b4bf",
          "#eaa83a",
          "#a63a32"
        ]
      },
      "legend": {
        "title": "Stock status",
        "orient": "bottom",
        "columns": 4,
        "symbolType": "square"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 3
      },
      "encoding": {
        "detail": {
          "field": "status",
          "type": "nominal"
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 90,
        "opacity": 1
      },
      "encoding": {
        "tooltip": [
          {
            "field": "status",
            "title": "Stock status",
            "type": "nominal"
          },
          {
            "field": "year",
            "title": "Year",
            "type": "quantitative",
            "format": "d"
          },
          {
            "field": "stocks",
            "title": "Number of stocks",
            "type": "quantitative"
          },
          {
            "field": "share",
            "title": "Share of assessed stocks",
            "type": "quantitative",
            "format": ".1%"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year == 2008 && datum.label_rank <= 3"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -10,
        "fontSize": 11,
        "fontWeight": 600
      },
      "encoding": {
        "text": {
          "field": "label",
          "type": "nominal"
        },
        "color": {
          "value": "#0b2a3c"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year == 2024 && datum.label_rank <= 3"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "fontSize": 11,
        "fontWeight": 600
      },
      "encoding": {
        "text": {
          "field": "label",
          "type": "nominal"
        },
        "color": {
          "value": "#0b2a3c"
        }
      }
    }
  ]
}